ENVIRONMENT=production
SECRET_KEY=change-to-a-long-random-secret-at-least-32-bytes
DATABASE_URL=sqlite:////app/data/shouna.db

# 图片存储。当前生产示例使用本地持久目录；对象存储需要后续实现对应 provider。
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/app/data/uploads
MAX_PHOTO_UPLOAD_BYTES=5242880
ALLOWED_PHOTO_MIME_TYPES=image/jpeg,image/png,image/webp

# AI_PROVIDER 可选：openai / anthropic；留空表示禁用 AI 智能录入
AI_PROVIDER=openai
AI_API_KEY=replace-with-your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
